* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #1e1f26;
  --card: #2b2d36;
  --verde: #3ddc97;
  --laranja: #ff9f7a;
  --azul: #3aa8f0;
  --certo: #2ecc71;
  --errado: #e74c3c;
  --texto: #f1f1f1;
}

body {
  font-family: "Segoe UI", Arial, sans-serif;
  background: var(--bg);
  color: var(--texto);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.quiz {
  width: 100%;
  max-width: 600px;
  background: var(--card);
  border: 2px dashed var(--verde);
  border-radius: 20px;
  padding: 24px;
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

h1 { color: var(--verde); font-size: 1.5rem; }

.badge {
  background: var(--azul);
  color: #fff;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.85rem;
  white-space: nowrap;
}

.progresso {
  height: 10px;
  background: #1a1b21;
  border-radius: 999px;
  overflow: hidden;
}

.progresso-barra {
  height: 100%;
  width: 0;
  background: var(--verde);
  transition: width 0.4s ease;
}

.contador {
  margin: 8px 0 16px;
  font-size: 0.85rem;
  color: #b5b8c4;
}

h2 { font-size: 1.2rem; margin-bottom: 16px; line-height: 1.4; }

.opcoes { display: flex; flex-direction: column; gap: 10px; }

.opcao {
  background: #1a1b21;
  color: var(--texto);
  border: 2px solid transparent;
  border-radius: 12px;
  padding: 14px;
  font-size: 1rem;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
}

.opcao:hover:not(:disabled) { border-color: var(--laranja); }
.opcao:disabled { cursor: default; }

.opcao.certa { background: var(--certo); border-color: var(--certo); color: #fff; }
.opcao.errada { background: var(--errado); border-color: var(--errado); color: #fff; }

.mensagem-feedback { min-height: 24px; margin-top: 14px; font-weight: 600; }
.mensagem-feedback.certo { color: var(--certo); }
.mensagem-feedback.errado { color: var(--errado); }

.btn {
  margin-top: 12px;
  width: 100%;
  background: var(--verde);
  color: #123325;
  border: none;
  border-radius: 12px;
  padding: 14px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
}

.btn:hover { filter: brightness(1.1); }

#tela-final { text-align: center; }
.nota { font-size: 2.5rem; font-weight: 800; color: var(--laranja); margin: 8px 0; }
.mensagem-final { margin-bottom: 8px; line-height: 1.5; }

[hidden] { display: none !important; }

@media (max-width: 480px) {
  .quiz { padding: 16px; }
  h1 { font-size: 1.2rem; }
  h2 { font-size: 1.05rem; }
}
